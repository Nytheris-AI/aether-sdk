# Aether SDK Local Development Environment
# Copy to .env and adjust as needed. All ports are non-default to avoid host collisions.

# Connection Strings
AETHER_POSTGRES_URL=postgresql://aether:aether_dev@localhost:15432/aether
AETHER_QDRANT_URL=http://localhost:16333
AETHER_QDRANT_GRPC_URL=http://localhost:16334
AETHER_NEO4J_URI=bolt://localhost:17687
AETHER_VALKEY_URL=redis://localhost:16379
AETHER_SQLITE_PATH=.aether/dev.db

# Optional Docker Compose Overrides
AETHER_POSTGRES_USER=aether
AETHER_POSTGRES_PASSWORD=aether_dev
AETHER_POSTGRES_DB=aether
AETHER_POSTGRES_PORT=15432

AETHER_QDRANT_HTTP_PORT=16333
AETHER_QDRANT_GRPC_PORT=16334

AETHER_NEO4J_USER=neo4j
AETHER_NEO4J_PASSWORD=aether_dev
AETHER_NEO4J_HTTP_PORT=17474
AETHER_NEO4J_BOLT_PORT=17687

AETHER_VALKEY_PORT=16379
